# Osamah Agent — environment overrides (EXPO_PUBLIC_* vars are inlined at bundle time)
#
# Copy this file to `.env`, then set the URL that a device can reach the voice
# gateway at. Expo Go ships this into the running app, so a phone works the
# moment it reloads — no rebuild needed.
#
# For production, use authenticated HTTPS endpoints. HTTP is for local debug only.
# Public / tunneled servers (works from any network):
#   https://your-gateway.example.com
#   https://xxxx.loca.lt
#
EXPO_PUBLIC_OPENCODE_URL=https://your-opencode.example.com
EXPO_PUBLIC_VOICE_GATEWAY_URL=https://your-gateway.example.com
# Optional local-only YouTube Data API key for the Reels search fallback.
EXPO_PUBLIC_YT_API_KEY=
